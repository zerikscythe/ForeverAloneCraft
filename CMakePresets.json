{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-windows-vs2022",
      "displayName": "VS2022 x64 base (no paths)",
      "description": "Shared generator/arch/output settings. Copy CMakeUserPresets.json.example to CMakeUserPresets.json and fill in your machine paths.",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/out/build-vs2022",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /utf-8",
        "CMAKE_C_FLAGS": "/DWIN32 /D_WINDOWS /utf-8"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-debug-worldserver",
      "displayName": "Build worldserver (Debug)",
      "configurePreset": "base-windows-vs2022",
      "configuration": "Debug",
      "targets": [
        "worldserver"
      ]
    },
    {
      "name": "vs2022-debug-unit-tests",
      "displayName": "Build unit_tests (Debug)",
      "configurePreset": "base-windows-vs2022",
      "configuration": "Debug",
      "targets": [
        "unit_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "vs2022-debug-ctest",
      "displayName": "CTest Debug",
      "configurePreset": "base-windows-vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
