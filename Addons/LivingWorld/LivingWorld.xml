    <!-- ============================================================ -->
    <!-- Minimap button                                                -->
    <!-- ============================================================ -->
    <Frame name="LWCPButtonFrame" parent="Minimap" enableMouse="true" hidden="false" frameStrata="LOW">
        <Size x="32" y="32" />
        <Anchors>
            <Anchor point="TOP" relativeTo="Minimap" relativePoint="TOP">
                <Offset><AbsDimension x="0" y="0" /></Offset>
            </Anchor>
        </Anchors>
        <Scripts>
            <OnLoad>LWCPButton_UpdatePosition();</OnLoad>
        </Scripts>
        <Frames>
            <Button name="LWCPMinimapButton">
                <Size x="24" y="24" />
                <Anchors>
                    <Anchor point="TOP"><Offset><AbsDimension x="0" y="0" /></Offset></Anchor>
                </Anchors>
                <NormalTexture file="Interface\Icons\Spell_Holy_AuraMastery" />
                <PushedTexture file="Interface\Icons\Spell_Holy_AuraMastery" />
                <HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" />
                <Scripts>
                    <OnLoad>
                        this:RegisterForDrag("RightButton");
                        this.dragging = false;
                    </OnLoad>
                    <OnDragStart>this.dragging = true;</OnDragStart>
                    <OnDragStop>this.dragging = false;</OnDragStop>
                    <OnUpdate>if this.dragging then LWCPButton_BeingDragged() end</OnUpdate>
                    <OnClick>LWCPButton_OnClick();</OnClick>
                    <OnEnter>LWCPButton_OnEnter();</OnEnter>
                    <OnLeave>GameTooltip:Hide();</OnLeave>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- ============================================================ -->
    <!-- Main panel                                                    -->
    <!-- ============================================================ -->
    <Frame name="LWCPFrame" parent="UIParent" toplevel="true" enableMouse="true" movable="true" hidden="true">
        <Size x="264" y="420" />
        <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="-60" /></Offset></Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets><AbsInset left="12" right="12" top="12" bottom="12" /></BackgroundInsets>
            <TileSize><AbsValue val="32" /></TileSize>
            <EdgeSize><AbsValue val="40" /></EdgeSize>
            <Color r="0" g="0" b="0" a="0.85" />
        </Backdrop>
        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
                this:RegisterEvent("PLAYER_LOGIN");
                this:RegisterEvent("PARTY_MEMBERS_CHANGED");
                this:RegisterEvent("CHAT_MSG_SYSTEM");
                this:RegisterEvent("CHAT_MSG_ADDON");
                this:RegisterEvent("MODIFIER_STATE_CHANGED");
                RegisterAddonMessagePrefix("LWBOT");
            </OnLoad>
            <OnDragStart>LWCPFrame:StartMoving();</OnDragStart>
            <OnDragStop>LWCPFrame:StopMovingOrSizing();</OnDragStop>
            <OnEvent>
                if event == "PLAYER_LOGIN" or event == "PARTY_MEMBERS_CHANGED" then LWCP_UpdateInventoryTabState() end
                if event == "CHAT_MSG_SYSTEM" then LWCP_HandleSystemMsg(arg1) end
                if event == "CHAT_MSG_ADDON" then LWCP_HandleAddonMsg(arg1, arg2, arg3, arg4) end
                if event == "MODIFIER_STATE_CHANGED" then LWCP_HandleModifierStateChanged(arg1) end
            </OnEvent>
            <OnShow>LWCP_RefreshRoster(); LWCP_ShowTab("Bots");</OnShow>
        </Scripts>

        <Layers>
            <Layer level="OVERLAY">
                <!-- Title -->
                <FontString inherits="GameFontHighlightLarge" text="LivingWorld CP">
                    <Size x="220" y="20" />
                    <Anchors>
                        <Anchor point="CENTER" relativePoint="TOP">
                            <Offset><AbsDimension x="0" y="-22" /></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <!-- Version -->
                <FontString inherits="GameFontHighlightSmallOutline" text="v1.0">
                    <Size x="40" y="14" />
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="BOTTOM">
                            <Offset><AbsDimension x="0" y="22" /></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

