/*.override.yml
/*.override.yaml

# Machine-local CMake dependency paths — each developer maintains their own copy.
# See CMakeUserPresets.json.example to get started.
CMakeUserPresets.json

!.gitkeep

# default build directory if not specified by CMAKE configuration
/out/*

# LivingWorld bot editor — local DB credentials, never commit
tools/lw-editor/config.ini

# Deploy binary tool — local server path, never commit
tools/deploy-binary/deploy.ini

# Generated data files — all tracked so the editor works on a fresh clone
# without needing the DBC extractor or WoW client files.
# Run extract_dbc_data.py to regenerate from updated DBC files.

# Throw-away diagnostic / session scripts — not part of the codebase
tools/lw-editor/check_bot_accounts.py
tools/lw-editor/diagnose_bot_accounts.py
tools/lw-editor/docs/BOT_ACCOUNT_DIAGNOSTICS.md
tools/lw-editor/_tmp_*.py
# Python bytecode
__pycache__/
*.pyc
*.pyo

