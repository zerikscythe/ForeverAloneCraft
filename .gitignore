#
# AzerothCore
#

/conf/*
!/conf/dist
/modules/*
!/modules/*.md
!/modules/*.sh
!/modules/CMakeLists.txt
!/modules/*.h
!/modules/*.cmake
# First-party modules live in-tree and must not be ignored.
!/modules/mod-living-world/
!/modules/mod-living-world/**
/build*/
/var/*
!/var/build/.gitkeep
!/var/ccache/.gitkeep
/env/dist/*
!/env/dist/.gitkeep
/env/user/*
/.env*
/apps/joiner
/deps/deno
/data/sql/custom/*
/src/server/scripts/Custom/*
!/src/server/scripts/Custom/README.md

/*.override.yml
/*.override.yaml

# Machine-local CMake dependency paths — each developer maintains their own copy.
# See CMakeUserPresets.json.example to get started.
CMakeUserPresets.json

!.gitkeep

# default build directory if not specified by CMAKE configuration
/out/*

# LivingWorld bot editor — local DB credentials, never commit
tools/lw-editor/config.ini

# Deploy binary tool — local server path, never commit
tools/deploy-binary/deploy.ini

# Generated data files — all tracked so the editor works on a fresh clone
# without needing the DBC extractor or WoW client files.
# Run extract_dbc_data.py to regenerate from updated DBC files.

# Throw-away diagnostic / session scripts — not part of the codebase
tools/lw-editor/check_bot_accounts.py
tools/lw-editor/diagnose_bot_accounts.py
tools/lw-editor/docs/BOT_ACCOUNT_DIAGNOSTICS.md
tools/lw-editor/_tmp_*.py
# Python bytecode
__pycache__/
*.pyc
*.pyo

#
#Generic
#

.directory
.mailmap
*.orig
*.rej
*~
.hg/
*.kdev*
.DS_Store
CMakeLists.txt.user
*.bak
*.patch
*.diff
*.REMOTE.*
*.BACKUP.*
*.BASE.*
*.LOCAL.*

#
# AI tools
#
.claude

#
# IDE & other software
#
/.settings/
/.externalToolBuilders/*
# exclude in all levels
nbproject/
.sync.ffs_db
*.kate-swp
.browse.VC*
.idea
cmake-build-*/*
coverage-report/
.vs

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

#
# Eclipse
#
*.pydevproject
.metadata
.gradle
tmp/
*.tmp
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.cproject

# vcpkg integration
/vcpkg/
/vcpkg-ports/


# ==================
#
#  CUSTOM
#
#  put below your custom ignore rules
#  for example , if you want to include a
#  module directly in repositoryyou can do:
#
#  !modules/yourmodule
#
# ==================

# Per-machine deploy target (see scripts/deploy-local.sh)
/deploy.local
/local_scripts
/.github/copilot-instructions.md
/_issues/Crashes
lw_gramcpp_tail.txt
lw_tail.txt
lw_script_tail.txt
lw_resolve.txt
lw_profset.txt
lw_modeset.txt
extract_resolve.ps1
extract_handlers.ps1
/collect_deployed_server_logs.ps1
